# ============================================
# 4S Clima - Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores

# Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# App Config
VITE_APP_NAME=4S Clima
VITE_APP_VERSION=1.0.0

# URL pública de producción para generación de códigos QR (ej: tu dominio en Vercel)
# Si no se define, se utiliza el origen actual del navegador
VITE_PUBLIC_PORTAL_URL=https://tu-proyecto.vercel.app
